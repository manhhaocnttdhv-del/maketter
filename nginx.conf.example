# ========================================================
# CẤU HÌNH NGINX CHO: tamnhinthuonghieu2026.io.vn
# ========================================================

# 1. FRONTEND CHÍNH (KÈM PROXY API & STORAGE)
server {
    listen 80;
    server_name tamnhinthuonghieu2026.io.vn www.tamnhinthuonghieu2026.io.vn;

    # Cho phép tải file ảnh lên tới 20MB (mặc định Nginx chỉ có 1MB)
    client_max_body_size 20M;

    # Thư mục chứa mã nguồn Vue 3 build
    root /var/www/maketter/frontend/dist;
    index index.html;

    # Gzip nén file
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Phục vụ ảnh upload từ Laravel Storage
    location /storage {
        alias /var/www/maketter/backend/public/storage;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        try_files $uri $uri/ =404;
    }

    # Chuyển tiếp thẳng các request /api sang Backend Laravel (KHÔNG dùng snippets fastcgi-php để tránh lỗi 404)
    location ~ ^/api {
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock; # Kiểm tra 'php -v' trên VPS (8.1, 8.2 hoặc 8.3)
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/maketter/backend/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
    }

    # Vue Router SPA
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Chặn file ẩn
    location ~ /\.(?!well-known).* {
        deny all;
    }
}

# 2. SUBDOMAIN API: api.tamnhinthuonghieu2026.io.vn
server {
    listen 80;
    server_name api.tamnhinthuonghieu2026.io.vn;

    client_max_body_size 20M;
    root /var/www/maketter/backend/public;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock; # Kiểm tra 'php -v' trên VPS (8.1, 8.2 hoặc 8.3)
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
